{
  "name": "Kostenloses OSINT Framework",
  "type": "folder",
  "description": "Konservativ kuratierter Katalog kostenloser Dienste und freier lokaler Software. Keine Vollprüfung des früheren Katalogs. Dokumentationsreferenzen sind hinterlegt; Live-Erreichbarkeit und aktuelle Nutzungsbedingungen müssen vor produktivem Einsatz geprüft werden.",
  "children": [
    {
      "name": "Domains & Infrastruktur",
      "type": "folder",
      "children": [
        {
          "name": "Zertifikate",
          "type": "folder",
          "children": [
            {
              "name": "crt.sh",
              "type": "url",
              "url": "https://crt.sh/",
              "description": "Öffentliche Certificate-Transparency-Suche mit JSON-Ausgabe. Ohne Konto oder API-Schlüssel; keine Verfügbarkeitsgarantie.",
              "pricing": "free",
              "api": true,
              "integration": "crtsh",
              "documentation": "https://crt.sh/?q=example.org&output=json",
              "input": "Domain",
              "output": "Zertifikate und darin enthaltene Hostnamen",
              "opsec": "passive"
            }
          ]
        },
        {
          "name": "Passive DNS",
          "type": "folder",
          "children": [
            {
              "name": "Mnemonic",
              "type": "url",
              "url": "https://passivedns.mnemonic.no/",
              "description": "Öffentlicher passiver DNS-Datensatz. Die kostenfreie öffentliche Abfrage ist vom kommerziellen Produktangebot des Betreibers getrennt.",
              "pricing": "free",
              "api": true,
              "integration": "mnemonic",
              "documentation": "https://docs.mnemonic.no/pdns/",
              "input": "Domain",
              "output": "Historische DNS-Beobachtungen",
              "opsec": "passive"
            }
          ]
        },
        {
          "name": "Webarchive",
          "type": "folder",
          "children": [
            {
              "name": "Internet Archive: Wayback Machine",
              "type": "url",
              "url": "https://web.archive.org/",
              "description": "Kostenloses Webarchiv. Die Availability-API ermittelt einen verfügbaren Snapshot, ohne die eingegebene Zieladresse selbst aufzurufen.",
              "pricing": "free",
              "api": true,
              "integration": "wayback",
              "documentation": "https://archive.org/help/wayback_api.php",
              "input": "HTTP- oder HTTPS-URL",
              "output": "Verfügbarer archivierter Snapshot",
              "opsec": "passive"
            }
          ]
        }
      ]
    },
    {
      "name": "Öffentliche Daten",
      "type": "folder",
      "children": [
        {
          "name": "Fahrzeuge",
          "type": "folder",
          "children": [
            {
              "name": "NHTSA Vehicle API",
              "type": "url",
              "url": "https://vpic.nhtsa.dot.gov/api/",
              "description": "Kostenfreie vPIC-Fahrzeugidentifikation der US-Verkehrssicherheitsbehörde. Keine Halterdaten.",
              "pricing": "free",
              "api": true,
              "integration": "nhtsa",
              "documentation": "https://vpic.nhtsa.dot.gov/api/",
              "input": "VIN, optional Modelljahr",
              "output": "Technische Fahrzeugdaten",
              "opsec": "passive"
            }
          ]
        },
        {
          "name": "Wirtschaft & Länder",
          "type": "folder",
          "children": [
            {
              "name": "World Bank Open Data",
              "type": "url",
              "url": "https://data.worldbank.org/",
              "description": "Öffentliche Länderindikatoren über die kostenfreie World-Bank-API, ohne Registrierung oder Schlüssel.",
              "pricing": "free",
              "api": true,
              "integration": "worldbank",
              "documentation": "https://datahelpdesk.worldbank.org/knowledgebase/articles/889392-about-the-indicators-api-documentation",
              "input": "Ländercode und Indikator",
              "output": "Indikatorwerte nach Jahr",
              "opsec": "passive"
            }
          ]
        },
        {
          "name": "Publikationen",
          "type": "folder",
          "children": [
            {
              "name": "Open Library",
              "type": "url",
              "url": "https://openlibrary.org/",
              "description": "Freie Bibliotheks-Metadatensuche. Kostenlose öffentliche Search-API für gelegentliche Abfragen; kein Massendownload.",
              "pricing": "free",
              "api": true,
              "integration": "openlibrary",
              "documentation": "https://openlibrary.org/developers/api",
              "input": "Suchtext (Titel, Autor oder ISBN)",
              "output": "Bibliografische Metadaten",
              "opsec": "passive"
            }
          ]
        }
      ]
    },
    {
      "name": "Lokale Werkzeuge",
      "type": "folder",
      "children": [
        {
          "name": "Benutzernamen",
          "type": "folder",
          "children": [
            {
              "name": "Sherlock",
              "type": "url",
              "url": "https://github.com/sherlock-project/sherlock",
              "description": "Freie lokale Software zur Benutzernamensuche. Wird nicht auf dem Webserver ausgeführt; Aufrufe der Zielplattformen unterliegen deren Bedingungen.",
              "pricing": "free",
              "localInstall": true,
              "api": false,
              "opsec": "active"
            },
            {
              "name": "WhatsMyName",
              "type": "url",
              "url": "https://github.com/WebBreacher/WhatsMyName",
              "description": "Freier Datensatz und lokale Werkzeuge zur Benutzernamenrecherche; keine gehostete API eingebunden.",
              "pricing": "free",
              "localInstall": true,
              "api": false,
              "opsec": "active"
            }
          ]
        },
        {
          "name": "Dateien & Analyse",
          "type": "folder",
          "children": [
            {
              "name": "Exiv2",
              "type": "url",
              "url": "https://exiv2.org/",
              "description": "Freie lokale Bildmetadatenanalyse. Dateien werden nicht über dieses Dashboard hochgeladen.",
              "pricing": "free",
              "localInstall": true,
              "api": false,
              "opsec": "passive"
            },
            {
              "name": "Ghidra",
              "type": "url",
              "url": "https://github.com/NationalSecurityAgency/ghidra",
              "description": "Freie lokale Reverse-Engineering-Suite ohne kostenpflichtigen Tarif. Separater Download, nicht Bestandteil der Webanwendung.",
              "pricing": "free",
              "localInstall": true,
              "api": false,
              "opsec": "passive"
            },
            {
              "name": "CyberChef",
              "type": "url",
              "url": "https://gchq.github.io/CyberChef/",
              "description": "Freie browserbasierte Kodierungs- und Datenanalyse. Kann separat lokal verwendet werden; keine Server-API benötigt.",
              "pricing": "free",
              "localInstall": false,
              "api": false,
              "opsec": "passive"
            },
            {
              "name": "Frida",
              "type": "url",
              "url": "https://frida.re/",
              "description": "Freie lokale dynamische Analyse eigener oder ausdrücklich autorisierter Anwendungen. Keine öffentliche Abfrage-API.",
              "pricing": "free",
              "localInstall": true,
              "api": false,
              "opsec": "active"
            }
          ]
        }
      ]
    }
  ]
}
